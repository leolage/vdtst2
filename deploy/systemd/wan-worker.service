[Unit]
Description=WAN Studio - worker (execução de jobs no ComfyUI)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=wan
WorkingDirectory=/opt/wan-studio
EnvironmentFile=/opt/wan-studio/.env
ExecStart=/usr/bin/node dist/worker/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/wan-studio

[Install]
WantedBy=multi-user.target

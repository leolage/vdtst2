[Unit]
Description=WAN Studio - cron (notificações Telegram: status da fila por hora)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=wan
WorkingDirectory=/opt/wan-studio
EnvironmentFile=/opt/wan-studio/.env
ExecStart=/usr/bin/node dist/notify/cron.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/wan-studio

[Install]
WantedBy=multi-user.target

# ---- wan-web ----
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# segredo da sessão (>= 32 chars). Gere com: openssl rand -hex 32
SESSION_SECRET=troque-isto-por-uma-string-aleatoria-de-32-bytes
# cookie seguro (true quando atrás de HTTPS/Cloudflare)
SESSION_SECURE=true

# ---- MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wan
DB_PASSWORD=senha-do-banco
DB_NAME=wan_studio

# ---- caminhos de dados (no servidor) ----
DATA_DIR=/var/lib/wan-studio
# inputs (imagens) e outputs (vídeos) ficam sob DATA_DIR

# ---- extração de frames (Fase 4) ----
# fps de amostragem; vazio = todos os frames (fps nativo do vídeo)
FRAME_EXTRACT_FPS=
FRAME_FORMAT=png
# extrair frames no servidor ComfyUI (mais parrudo) e baixar para a VM
FRAME_EXTRACT_ON_NODE=true

# ---- worker / agente (usados nas fases seguintes) ----
WORKER_POLL_MS=2000
AGENT_DECISION_MS=45000
AGENT_HEALTH_MS=10000
# chave da API do Claude para o agente de decisão
ANTHROPIC_API_KEY=
# modelo das decisões (padrão Opus 4.8; troque por sonnet/haiku para reduzir custo)
AGENT_DECISION_MODEL=claude-opus-4-8
# fila por nó abaixo da qual o agente pode disparar mais trabalho
AGENT_FILA_BAIXA=1
# comando para reiniciar o ComfyUI num nó travado (ação restart_node)
COMFY_RESTART_CMD=sudo systemctl restart comfyui

# segredo para cifrar chaves SSH dos nós at-rest. openssl rand -hex 32
SSH_KEY_ENCRYPTION_KEY=

# ---- execução no ComfyUI (worker) ----
COMFY_JOB_TIMEOUT_MS=1800000
COMFY_POLL_MS=3000
# diretório de saída do ComfyUI no host remoto (para extrair frames lá)
COMFY_OUTPUT_DIR=ComfyUI/output

# ---- Notificações Telegram (wan-cron + eventos) ----
# token do bot (via @BotFather) e id do grupo (negativo, ex.: -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- wan-web ----
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# segredo da sessão (>= 32 chars). Gere com: openssl rand -hex 32
SESSION_SECRET=troque-isto-por-uma-string-aleatoria-de-32-bytes
# cookie seguro (true quando atrás de HTTPS/Cloudflare)
SESSION_SECURE=true

# ---- MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wan
DB_PASSWORD=senha-do-banco
DB_NAME=wan_studio

# ---- caminhos de dados (no servidor) ----
DATA_DIR=/var/lib/wan-studio
# inputs (imagens) e outputs (vídeos) ficam sob DATA_DIR

# ---- worker / agente (usados nas fases seguintes) ----
WORKER_POLL_MS=2000
AGENT_DECISION_MS=45000
AGENT_HEALTH_MS=10000
# chave da API do Claude para o agente (Fase 6)
ANTHROPIC_API_KEY=
AGENT_DECISION_MODEL=claude-sonnet-4-6
AGENT_HEALTH_MODEL=claude-haiku-4-5-20251001

# segredo para cifrar chaves SSH dos nós at-rest (Fase 4). openssl rand -hex 32
SSH_KEY_ENCRYPTION_KEY=

# ---- Notificações Telegram (wan-cron + eventos) ----
# token do bot (via @BotFather) e id do grupo (negativo, ex.: -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
